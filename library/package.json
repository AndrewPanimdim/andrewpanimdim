{
  "name": "andrewpanimdim",
  "version": "0.3.0",
  "description": "Tiny dependency-free web effects: scramble text, split text, draggable, cursertrack.",
  "license": "MIT",
  "author": "Andrew Panimdim",
  "keywords": [
    "text",
    "animation",
    "scramble",
    "split-text",
    "typescript",
    "cursor",
    "draggable"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./scramble": {
      "import": {
        "types": "./dist/scramble.d.ts",
        "default": "./dist/scramble.js"
      },
      "require": {
        "types": "./dist/scramble.d.cts",
        "default": "./dist/scramble.cjs"
      }
    },
    "./split": {
      "import": {
        "types": "./dist/split.d.ts",
        "default": "./dist/split.js"
      },
      "require": {
        "types": "./dist/split.d.cts",
        "default": "./dist/split.cjs"
      }
    },
    "./package.json": "./package.json",
    "./draggable": {
      "import": {
        "types": "./dist/draggable.d.ts",
        "default": "./dist/draggable.js"
      },
      "require": {
        "types": "./dist/draggable.d.cts",
        "default": "./dist/draggable.cjs"
      }
    },
    "./cursortrack": {
      "import": {
        "types": "./dist/cursortrack.d.ts",
        "default": "./dist/cursortrack.js"
      },
      "require": {
        "types": "./dist/cursortrack.d.cts",
        "default": "./dist/cursortrack.cjs"
      }
    },
    "./scrolltilt": {
      "import": {
        "types": "./dist/scrolltilt.d.ts",
        "default": "./dist/scrolltilt.js"
      },
      "require": {
        "types": "./dist/scrolltilt.d.cts",
        "default": "./dist/scrolltilt.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewPanimdim/andrewpanimdim.git",
    "directory": "library"
  }
}
